# Normalize line endings: LF in the repo, native on checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat these as binary.
*.xlsx binary
*.db binary

# Machine-written: collapse in diffs, keep out of language stats.
uv.lock linguist-generated
web/package-lock.json linguist-generated