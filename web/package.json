{
  "name": "monay-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen:openapi": "uv run python -m monay.api.openapi openapi.json",
    "gen:types": "openapi-typescript openapi.json -o src/api/schema.gen.ts",
    "gen:tokens": "node scripts/build-tokens.mjs",
    "gen": "npm run gen:openapi && npm run gen:types && npm run gen:tokens",
    "dev": "npm run gen && vite",
    "build": "npm run gen:types && npm run gen:tokens && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.52.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}
